% Large Tokamak reference model for TETRA (Tokamak Engineering Test Reactor
% Analysis), a large tokamak fusion reactor cost model based on UKAEA PROCESS:
% https://github.com/ukaea/PROCESS.

accert{
    ref_model = "large_tokamak"

    % Ask ACCERT to write the overnight capital cost summary, which
    % is what the OCC results of the plugin are read from.
    post_process { occ = true }

    % Financial and operating assumptions behind the levelized cost of
    % electricity, which ACCERT writes out for its fusion models
    var(discount_rate){ value = {{ discount_rate }} unit = N/A }
    var(cfactr){ value = {{ capacity_factor }} unit = N/A }
    var(tlife){ value = {{ plant_life }} unit = years }
    var(pnetelmw){ value = {{ net_electric_power }} unit = MW }

    l0COA(2){
        l1COA(21){
            l2COA("211"){
                alg("acc211"){
                    % Allowance for site costs
                    var("csi"){ value = {{ site_cost }} unit = million }
                    % Level of safety assurance, generally 3 or 4
                    var("lsa"){ value = 4 unit = N/A }
                }
            }
        }
    }
}
